{
  "private": true,
  "name": "@nestia/test-sdk",
  "version": "14.0.2",
  "scripts": {
    "test:unit": "cross-env NODE_OPTIONS=\"--no-experimental-strip-types --no-experimental-detect-module\" ttsx --no-plugins src/index.ts",
    "start": "cross-env NODE_OPTIONS=\"--no-experimental-strip-types --no-experimental-detect-module\" ttsx --no-plugins src/integration/SdkRunner.ts",
    "evidence": "evidence --config evidence.config.json",
    "integration": "cross-env NODE_OPTIONS=\"--no-experimental-strip-types --no-experimental-detect-module\" TEST_SDK_SKIP_BUILD=1 ttsx --no-plugins src/integration/index.ts"
  },
