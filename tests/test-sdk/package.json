{
  "private": true,
  "name": "@nestia/test-sdk",
  "version": "14.0.1",
  "scripts": {
    "dev": "ttsc --watch",
    "start": "cross-env TTSC_GO_BINARY=go TTSC_CACHE_DIR=../../node_modules/.cache/ttsc NODE_OPTIONS=\"--no-experimental-strip-types --no-experimental-detect-module\" node ../../scripts/run-unit.cjs --workspace test-sdk"
  },
  "dependencies": {
    "@nestia/e2e": "workspace:^",
    "@nestia/sdk": "workspace:^",
    "@nestia/core": "workspace:^",
    "@nestjs/common": "catalog:nestjs",
    "@nestjs/swagger": "catalog:nestjs",
    "typia": "catalog:samchon",
    "@nestia/fetcher": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:utils",
    "cross-env": "catalog:utils",
    "ttsc": "catalog:typescript",
    "@ttsc/factory": "catalog:typescript"
  },
  "packageManager": "pnpm@10.6.4"
}
