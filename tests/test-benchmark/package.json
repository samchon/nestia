{
  "private": true,
  "name": "@nestia/test-benchmark",
  "version": "14.0.2",
  "scripts": {
    "test:unit": "cross-env NODE_OPTIONS=\"--no-experimental-strip-types --no-experimental-detect-module\" ttsx --no-plugins -P tsconfig.unit.json src/unit.ts",
    "dev": "ttsc --watch",
    "start": "pnpm test:unit",
    "evidence": "evidence --config evidence.config.json"
  },
  "dependencies": {
    "@nestia/benchmark": "workspace:^",
    "@nestia/e2e": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:utils",
    "cross-env": "catalog:utils",
    "ttsc": "catalog:typescript"
  },
  "packageManager": "pnpm@10.6.4"
}
