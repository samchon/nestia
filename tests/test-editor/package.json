{
  "private": true,
  "name": "@nestia/test-editor",
  "version": "14.0.2",
  "scripts": {
    "dev": "ttsc --watch",
    "start": "cross-env NODE_OPTIONS=\"--no-experimental-strip-types --no-experimental-detect-module\" ttsx --no-plugins src/UnitRunner.ts",
    "test:unit": "cross-env NODE_OPTIONS=\"--no-experimental-strip-types --no-experimental-detect-module\" ttsx --no-plugins src/UnitRunner.ts",
    "test:unit:browser": "cross-env NODE_OPTIONS=\"--no-experimental-strip-types --no-experimental-detect-module\" ttsx --no-plugins src/browser/index.ts",
    "test:unit:ssr": "cross-env NODE_OPTIONS=\"--no-experimental-strip-types --no-experimental-detect-module\" ttsx --no-plugins src/index.ts",
    "evidence": "evidence --config evidence.config.json"
  },
  "dependencies": {
    "@nestia/e2e": "workspace:^"
  },
  "devDependencies": {
    "@nestia/editor": "workspace:^",
    "@types/node": "catalog:utils",
    "cross-env": "catalog:utils",
    "fflate": "^0.8.2",
    "ttsc": "catalog:typescript",
    "jsdom": "catalog:utils",
    "react": "catalog:utils"
  },
  "packageManager": "pnpm@10.6.4"
}
